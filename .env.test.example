# Test Environment Configuration
# Copy this file to .env.test and fill in your test API keys
# .env.test is gitignored and will not be committed to version control

# OpenAI API Key (for GPT models testing)
OPENAI_API_KEY=your-openai-test-key-here

# Google API Key (for Google services testing)
GOOGLE_API_KEY=your-google-test-key-here

# ElevenLabs API Key (for TTS testing)
ELEVEN_LABS_API_KEY=your-elevenlabs-test-key-here

# Groq API Key (for Groq LLM testing)
GROQ_API_KEY=your-groq-test-key-here

# NVIDIA API Key (for NVIDIA services testing)
NVIDIA_API_KEY=your-nvidia-test-key-here

# Cohere API Key (for Cohere LLM testing)
COHERE_API_KEY=your-cohere-test-key-here

# xAI API Key (for xAI services testing)
XAI_API_KEY=your-xai-test-key-here

# Anthropic API Key (for Claude models testing)
ANTHROPIC_API_KEY=your-anthropic-test-key-here

# Note: If these variables are not set, placeholder values will be used
# which should work for most unit tests that mock external API calls
